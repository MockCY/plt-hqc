<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinglian.fitness.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.qinglian.fitness.user.User">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="openid" javaType="java.lang.String"/>
            <arg column="unionid" javaType="java.lang.String"/>
            <arg column="phone" javaType="java.lang.String"/>
            <arg column="nickname" javaType="java.lang.String"/>
            <arg column="avatar_url" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="userColumns">
        id, openid, unionid, phone, nickname, avatar_url, status, created_at, updated_at
    </sql>

    <select id="findByOpenId" resultMap="userResultMap">
        select <include refid="userColumns"/>
        from users
        where openid = #{openId}
    </select>

    <select id="findById" resultMap="userResultMap">
        select <include refid="userColumns"/>
        from users
        where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into users (openid, unionid, status)
        values (#{openId}, #{unionId}, 'ACTIVE')
    </insert>

    <update id="bindPhone">
        update users
        set phone = #{phone},
            country_code = #{countryCode},
            updated_at = current_timestamp
        where id = #{userId}
    </update>

    <delete id="deleteCustomCourses">
        delete from custom_courses where user_id = #{userId}
    </delete>

    <delete id="deleteFavorites">
        delete from user_favorites where user_id = #{userId}
    </delete>

    <delete id="deletePlanSelections">
        delete from user_plan_selections where user_id = #{userId}
    </delete>

    <delete id="deleteFeedback">
        delete from user_feedback where user_id = #{userId}
    </delete>

    <delete id="deleteCampaignCheckins">
        delete from campaign_checkins where user_id = #{userId}
    </delete>

    <delete id="deleteSettings">
        delete from user_settings where user_id = #{userId}
    </delete>

    <delete id="deleteWorkoutRecords">
        delete from workout_records where user_id = #{userId}
    </delete>

    <delete id="deleteSessions">
        delete from auth_sessions where user_id = #{userId}
    </delete>

    <delete id="deleteById">
        delete from users where id = #{userId}
    </delete>

</mapper>
