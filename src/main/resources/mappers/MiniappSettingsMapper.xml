<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinglian.fitness.mapper.MiniappSettingsMapper">
  <resultMap id="settings" type="com.qinglian.fitness.settings.MiniappSettings">
    <result column="version_number" property="versionNumber" />
    <result column="update_content" property="updateContent" />
    <result column="app_version" property="appVersion" />
    <result column="revision" property="revision" />
  </resultMap>
  <select id="find" resultMap="settings">
    SELECT app_version, version_number, update_content, revision FROM miniapp_settings WHERE id = 1
  </select>
  <!-- 版本条件避免并发保存静默覆盖，版本递增使同值保存也能准确检测。 -->
  <update id="update">
    UPDATE miniapp_settings
    <set>
      app_version = #{appVersion},
      <if test="_parameter.hasVersionNumber()">version_number = #{versionNumber},</if>
      <if test="_parameter.hasUpdateContent()">update_content = #{updateContent},</if>
      revision = revision + 1
    </set>
    WHERE id = 1 AND revision = #{revision}
  </update>
</mapper>
