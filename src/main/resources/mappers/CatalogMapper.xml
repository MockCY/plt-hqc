<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinglian.fitness.mapper.CatalogMapper">

    <resultMap id="courseResultMap" type="com.qinglian.fitness.catalog.CatalogDtos$CourseView">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="type" javaType="java.lang.String"/>
            <arg column="duration_minutes" javaType="_int"/>
            <arg column="level" javaType="java.lang.String"/>
            <arg column="equipment" javaType="java.lang.String"/>
            <arg column="summary" javaType="java.lang.String"/>
            <arg column="cover_image" javaType="java.lang.String"/>
            <arg column="video_url" javaType="java.lang.String"/>
            <arg column="video_cover_image" javaType="java.lang.String"/>
            <arg column="video_duration_seconds" javaType="java.lang.Integer"/>
            <arg column="view_count" javaType="_long"/>
            <arg column="exercise_count" javaType="_int"/>
        </constructor>
    </resultMap>

    <resultMap id="exerciseResultMap" type="com.qinglian.fitness.catalog.CatalogDtos$ExerciseView">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="body_part" javaType="java.lang.String"/>
            <arg column="level" javaType="java.lang.String"/>
            <arg column="equipment" javaType="java.lang.String"/>
            <arg column="suggested_sets" javaType="_int"/>
            <arg column="target" javaType="java.lang.String"/>
            <arg column="cue" javaType="java.lang.String"/>
            <arg column="safety_tip" javaType="java.lang.String"/>
            <arg column="cover_image" javaType="java.lang.String"/>
            <arg column="video_url" javaType="java.lang.String"/>
            <arg column="video_cover_image" javaType="java.lang.String"/>
            <arg column="video_duration_seconds" javaType="java.lang.Integer"/>
            <arg column="background_music_url" javaType="java.lang.String"/>
            <arg column="focus_image_url" javaType="java.lang.String"/>
            <arg column="focus_parts" javaType="java.lang.String"/>
            <arg column="spring_sets" javaType="java.util.List" typeHandler="com.qinglian.fitness.mapper.IntegerListTypeHandler"/>
            <arg column="key_points" javaType="java.lang.String"/>
            <arg column="common_mistakes" javaType="java.lang.String"/>
            <arg column="instruction_audio_url" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="courseDetailResultMap" type="com.qinglian.fitness.mapper.CatalogMapper$CourseDetailRow">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="type" javaType="java.lang.String"/>
            <arg column="duration_minutes" javaType="_int"/>
            <arg column="level" javaType="java.lang.String"/>
            <arg column="equipment" javaType="java.lang.String"/>
            <arg column="summary" javaType="java.lang.String"/>
            <arg column="cover_image" javaType="java.lang.String"/>
            <arg column="video_url" javaType="java.lang.String"/>
            <arg column="video_cover_image" javaType="java.lang.String"/>
            <arg column="video_duration_seconds" javaType="java.lang.Integer"/>
            <arg column="view_count" javaType="_long"/>
            <arg column="introduction" javaType="java.lang.String"/>
            <arg column="audience" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="courseExerciseResultMap" type="com.qinglian.fitness.catalog.CatalogDtos$CourseExerciseView">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="target" javaType="java.lang.String"/>
            <arg column="cue" javaType="java.lang.String"/>
            <arg column="safety_tip" javaType="java.lang.String"/>
            <arg column="duration_seconds" javaType="_int"/>
            <arg column="cover_image" javaType="java.lang.String"/>
            <arg column="video_url" javaType="java.lang.String"/>
            <arg column="video_cover_image" javaType="java.lang.String"/>
            <arg column="video_duration_seconds" javaType="java.lang.Integer"/>
            <arg column="background_music_url" javaType="java.lang.String"/>
            <arg column="instruction_audio_url" javaType="java.lang.String"/>
            <arg column="training_sets" javaType="java.util.List" typeHandler="com.qinglian.fitness.mapper.TrainingSetListTypeHandler"/>
        </constructor>
    </resultMap>

    <select id="findCourses" resultMap="courseResultMap">
        select c.id, c.title, c.type, c.duration_minutes, c.level, c.equipment,
               c.summary, c.cover_image, c.video_url, c.video_cover_image, c.video_duration_seconds, c.view_count,
               count(ce.exercise_id) exercise_count
        from courses c
        left join course_exercises ce on ce.course_id = c.id
        where c.status = 'PUBLISHED'
        <if test="type != null">
            and c.type = #{type}
        </if>
        <if test="query != null">
            and (c.title like concat('%', #{query}, '%')
                 or c.summary like concat('%', #{query}, '%')
                 or c.type like concat('%', #{query}, '%'))
        </if>
        group by c.id, c.title, c.type, c.duration_minutes, c.level, c.equipment,
                 c.summary, c.cover_image, c.video_url, c.video_cover_image, c.video_duration_seconds, c.view_count, c.sort_order
        order by c.sort_order, c.id
    </select>

    <select id="findExercises" resultMap="exerciseResultMap">
        select id, name, body_part, level, equipment, suggested_sets, target, cue, safety_tip,
               cover_image, video_url, video_cover_image, video_duration_seconds, background_music_url,
               focus_image_url, focus_parts, spring_sets, key_points, common_mistakes, instruction_audio_url
        from exercises
        where status = 'PUBLISHED'
        <if test="bodyPart != null">
            and body_part = #{bodyPart}
        </if>
        <if test="query != null">
            and (name like concat('%', #{query}, '%')
                 or body_part like concat('%', #{query}, '%'))
        </if>
        order by sort_order, id
    </select>

    <select id="findCourse" resultMap="courseDetailResultMap">
        select id, title, type, duration_minutes, level, equipment, summary, cover_image,
               video_url, video_cover_image, video_duration_seconds, view_count, introduction, audience
        from courses
        where id = #{id} and status = 'PUBLISHED'
    </select>

    <select id="findCourseExercises" resultMap="courseExerciseResultMap">
        select e.id, e.name, coalesce(ce.target, e.target) target, e.cue, e.safety_tip,
               coalesce(ce.duration_seconds, 60) duration_seconds,
               e.cover_image, e.video_url, e.video_cover_image, e.video_duration_seconds, e.background_music_url,
               e.instruction_audio_url, coalesce(ce.training_sets, json_array(json_object(
                   'side', '双侧', 'durationSeconds', coalesce(ce.duration_seconds, 60), 'repetitions', 0, 'springCount', 0))) training_sets
        from course_exercises ce
        join exercises e on e.id = ce.exercise_id
        where ce.course_id = #{courseId} and e.status = 'PUBLISHED'
        order by ce.sort_order, e.id
    </select>

    <insert id="recordCourseView">
        insert ignore into course_views(course_id, visitor_key, viewed_on)
        values(#{courseId}, #{visitorKey}, current_date())
    </insert>

    <update id="incrementCourseViewCount">
        update courses set view_count = view_count + 1 where id = #{courseId}
    </update>

</mapper>
